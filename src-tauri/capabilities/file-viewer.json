{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "file-viewer",
  "description": "Capability for file viewer popup windows",
  "windows": [
    "file-viewer-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-write-text",
    "allow-cancel-app-quit",
    "allow-cancel-transfer",
    "allow-create-file",
    "allow-download-remote-file",
    "allow-editor-dirty-changed",
    "allow-get-home-directory",
    "allow-get-session-health",
    "allow-open-in-os",
    "allow-read-file-content",
    "allow-read-remote-file-base64"
  ]
}
