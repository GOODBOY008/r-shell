---
interface Props {
  zh: boolean;
}

const { zh } = Astro.props;
const base = zh ? '/zh' : '';
const copy = zh
  ? {
      kind: '开源 SSH 与远程桌面客户端',
      headline: ['多台主机，', '并排管理。'],
      intro: '把不同主机的 SSH 会话放进分屏，在标签页中打开 RDP 或 VNC 桌面，随时查看远程文件和系统指标。',
      download: '下载 R-Shell',
      handbook: '阅读用户手册',
      platforms: '适用于 macOS、Windows 和 Linux',
      screenshot: '在两个分屏终端中，edge-01 显示部署日志，edge-02 运行 htop。下方打开了 SFTP 文件浏览器。',
      demo: '两个 SSH 会话中的灰度部署检查',
      expand: '查看原图',
      features: [
        {
          title: '在本地与远端之间传文件',
          description: '在双栏文件浏览器中上传目录、打开远程配置文件。同步前可以逐项比较差异，选择要传输或跳过的文件。',
          alt: '双栏 SFTP 文件浏览器中选中了本地构建文件，下方传输队列显示了上传进度。',
          link: '文件传输指南',
        },
        {
          title: '把多台主机的指标放在一起看',
          description: '通过 SSH 采集数据，将不同主机的请求量、延迟和服务状态放在同一块看板上。把发布检查清单放在图表旁，边观察边核对。',
          alt: 'Edge fleet 看板并排展示两台主机的请求率、P95 响应时间、服务健康状态和灰度发布清单。',
          link: '监控与看板指南',
        },
      ],
    }
  : {
      kind: 'Open-source SSH and remote desktop client',
      headline: ['Your servers,', 'side by side.'],
      intro: 'Split SSH sessions across your screen, open RDP or VNC desktops in tabs, and keep remote files and live system metrics in view.',
      download: 'Download R-Shell',
      handbook: 'Read the handbook',
      platforms: 'For macOS, Windows, and Linux',
      screenshot: 'Split SSH terminals show deployment logs on edge-01 and htop on edge-02, above an SFTP browser with remote configuration files.',
      demo: 'Checking a canary deployment across two SSH sessions',
      expand: 'View full image',
      features: [
        {
          title: 'Move files between machines',
          description: 'Upload a directory or open a remote configuration file in the dual-pane file browser. Compare changes before you sync, then choose which files to transfer or skip.',
          alt: 'The two-pane SFTP browser shows selected local build files, a remote site directory, and an active upload in the transfer queue.',
          link: 'File transfer guide',
        },
        {
          title: 'Compare metrics across hosts',
          description: 'Collect data over SSH and put request rates, latency, and service health on the same dashboard. Keep a rollout checklist beside the charts as you watch a deployment.',
          alt: 'An Edge fleet dashboard compares request rate and P95 response time across two hosts beside service health and a canary rollout checklist.',
          link: 'Monitoring and dashboards',
        },
      ],
    };
const features = [
  { ...copy.features[0], path: 'transfers', image: 'file-transfer-workspace', width: 1100, height: 742 },
  { ...copy.features[1], path: 'monitoring', image: 'multi-host-dashboard', width: 1460, height: 1034 },
];
---

<div class="home">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="product-kind">{copy.kind}</p>
      <h1 id="home-title">{copy.headline[0]}<span>{copy.headline[1]}</span></h1>
      <p class="intro">{copy.intro}</p>
      <div class="actions">
        <a class="primary" href={`${base}/download/`}>{copy.download}</a>
        <a class="secondary" href={`${base}/docs/`}>{copy.handbook}</a>
      </div>
      <p class="platforms">{copy.platforms}</p>
    </div>
    <figure class="hero-visual">
      <div class="hero-screen">
        <img
          src="/media/ssh-workspace.webp"
          width="1540"
          height="980"
          alt={copy.screenshot}
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>{copy.demo}</span>
        <a href="/media/ssh-workspace.webp">{copy.expand}</a>
      </figcaption>
    </figure>
  </section>

  {features.map((feature, i) => (
    <section class:list={['feature', { reverse: i === 1 }]} aria-labelledby={`feature-${feature.path}`}>
      <div class="feature-copy">
        <h2 id={`feature-${feature.path}`}>{feature.title}</h2>
        <p>{feature.description}</p>
        <a class="guide-link" href={`${base}/docs/${feature.path}/`}>{feature.link}</a>
      </div>
      <div class="feature-screen">
        <img
          src={`/media/${feature.image}.webp`}
          width={feature.width}
          height={feature.height}
          alt={feature.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>
  ))}
</div>

<style>
  .home {
    --home-ink: #f3f7f8;
    --home-copy: #b5c4cd;
    --home-muted: #9aaeb8;
    --home-accent: #a0eed4;
    --home-rule: #2a393f;
    color: var(--home-ink);
    width: min(100%, 88rem);
    margin-inline: auto;
    padding-inline: clamp(1.15rem, 4.8vw, 4.2rem);
    container: homepage / inline-size;
  }

  .home :where(h1, h2, p, figure) { margin: 0; }
  .home :where(a:focus-visible) { outline: 3px solid #74dfce; outline-offset: 4px; }
  .hero,
  .feature { display: grid; align-items: center; gap: clamp(1.5rem, 5cqi, 4rem); }
  .hero { padding-block: clamp(2.5rem, 7cqi, 6.75rem) clamp(2.75rem, 6cqi, 5.25rem); }
  .hero-copy,
  .hero-visual,
  .feature-copy,
  .feature-screen { min-width: 0; }

  .product-kind {
    color: var(--home-accent);
    font-size: .9rem;
    line-height: 1.5;
    font-weight: 600;
  }
  .home h1 {
    margin-block: .9rem 1.2rem;
    color: var(--home-ink);
    font-size: clamp(3rem, 1.7rem + 3.9vw, 5.8rem);
    line-height: .99;
    letter-spacing: -.058em;
    font-weight: 700;
  }
  .home h1 span { display: block; color: var(--home-accent); }
  .home:lang(zh-CN) h1,
  .home:lang(zh) h1 { line-height: 1.15; letter-spacing: -.04em; }
  .intro,
  .feature-copy p { color: var(--home-copy); line-height: 1.65; }
  .intro { max-width: 42ch; font-size: clamp(1.0625rem, 1rem + .3vw, 1.27rem); }
  .actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-block-start: 1.6rem; }
  .actions a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 2.875rem;
    padding: .64rem 1.15rem;
    border: 1px solid transparent;
    border-radius: .5rem;
    text-decoration: none;
    font-size: .99rem;
    line-height: 1.4;
    font-weight: 650;
  }
  .actions .primary { color: #0b2320; background: var(--home-accent); }
  .actions .primary:hover { background: #c6f7e9; }
  .actions .secondary { color: var(--home-ink); border-color: #516269; }
  .actions .secondary:hover { border-color: var(--home-accent); }
  .platforms { padding-block-start: .8rem; color: var(--home-muted); font-size: .9rem; }

  .hero-screen,
  .feature-screen {
    position: relative;
    border: 1px solid #3e575c;
    border-radius: .8rem;
    background: #131d24;
  }
  .hero-screen {
    padding: clamp(.32rem, .65cqi, .55rem);
    background: linear-gradient(135deg, #254049 0%, #233139 54%, #173c35);
    box-shadow: 0 1.15rem 3.8rem -1.7rem #020605;
  }
  .hero-screen img,
  .feature-screen img { display: block; width: 100%; height: auto; }
  .hero-screen img { border-radius: .44rem; }
  .hero-visual figcaption {
    padding: .7rem .1rem 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .45rem 1rem;
    flex-wrap: wrap;
    color: var(--home-muted);
    font-size: .875rem;
    line-height: 1.45;
  }
  figcaption a,
  .guide-link { color: var(--home-accent); text-underline-offset: .22em; }
  figcaption a { padding-block: .18rem; }
  .feature { padding-block: clamp(2.4rem, 5cqi, 4rem); border-top: 1px solid var(--home-rule); }
  .feature-copy { max-width: 37rem; }
  .home h2 {
    color: var(--home-ink);
    font-size: clamp(1.85rem, 1.2rem + 2.3vw, 3.1rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -.04em;
  }
  .home:lang(zh-CN) h2,
  .home:lang(zh) h2 { line-height: 1.28; }
  .feature-copy p { margin-block-start: 1.05rem; font-size: 1.0625rem; max-width: 49ch; }
  .guide-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block-start: .65rem;
    font-weight: 550;
  }
  .feature-screen { padding: .3rem; }
  .feature-screen img { border-radius: .46rem; }

  @container homepage (min-width: 54rem) {
    .hero { grid-template-columns: minmax(0, .84fr) minmax(0, 1.35fr); column-gap: clamp(1.75rem, 3.6cqi, 3.5rem); }
    .home h1 { font-size: clamp(3rem, 1rem + 4.65cqi, 5.55rem); }
    .feature { grid-template-columns: minmax(0, .78fr) minmax(0, 1.18fr); }
    .feature.reverse { grid-template-columns: minmax(0, 1.18fr) minmax(0, .78fr); }
    .reverse .feature-copy { grid-area: 1 / 2; }
    .reverse .feature-screen { grid-area: 1 / 1; }
  }
</style>
