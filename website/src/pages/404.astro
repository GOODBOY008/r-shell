---
const { t } = Astro.locals;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>{t('site.notFound.title')} · R-Shell</title></head><body><main><h1>{t('site.notFound.title')} <span lang="zh-CN">· {t('site.notFound.title', { lng: 'zh-CN' })}</span></h1><p><a href="/">{t('site.notFound.home')}</a> · <a lang="zh-CN" href="/zh/">{t('site.notFound.home', { lng: 'zh-CN' })}</a></p></main></body></html>
<style>body{background:#10181e;color:#e7f1ed;margin:0;font:1rem/1.5 system-ui,sans-serif}main{max-width:50rem;padding:8vh 1.5rem;margin:auto}a{color:#a0e6cc}h1{font-size:clamp(1.5rem,5vw,3rem)}</style>
